# Main service identity
SERVICE_NAME=pc2-coach-api

# Network binding
HOST=0.0.0.0
PORT=7000

# Primary LLM provider
# Primary LLM is used first for coach generation and is required for profile routine generation.
NVIDIA_API_KEY=
PRIMARY_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
PRIMARY_LLM_MODEL_NAME=google/gemma-4-31b-it
PRIMARY_LLM_API_KEY=

# Standard fallback vLLM runtime
FALLBACK_LLM_ENABLED=true
FALLBACK_LLM_BASE_URL=http://127.0.0.1:8000/v1
FALLBACK_LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct-AWQ
FALLBACK_LLM_API_KEY=EMPTY
HF_TOKEN=

# Runtime tuning
LLM_TIMEOUT_SECONDS=60
LLM_HEALTH_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.3

# Local storage
DB_PATH=./data/pc2_coach.db

# Notes
# - Empty or missing env values fall back to built-in defaults.
# - Standard runtime assumes fallback vLLM is running on port 8000 with Qwen/Qwen2.5-1.5B-Instruct-AWQ.
# - If all LLM settings are unavailable, PC2 still runs and returns local rule-based plans for /api/coach/generate.
