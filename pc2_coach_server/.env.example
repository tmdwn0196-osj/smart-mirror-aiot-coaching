# Main service identity
SERVICE_NAME=pc2-coach-api

# Network binding
HOST=0.0.0.0
PORT=7000

# Primary LLM provider
# Primary LLM is used first for coach generation and is required for profile routine generation.
NVIDIA_API_KEY=
PRIMARY_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
PRIMARY_LLM_MODEL_NAME=mistralai/mistral-nemotron
PRIMARY_LLM_API_KEY=
# Hugging Face Endpoint example:
# PRIMARY_LLM_BASE_URL=https://<your-hf-endpoint-host>/v1
# PRIMARY_LLM_MODEL_NAME=LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct
# PRIMARY_LLM_API_KEY=<your-hf-endpoint-token>
# Local primary EXAONE test example:
# PRIMARY_LLM_BASE_URL=http://127.0.0.1:8100/v1
# PRIMARY_LLM_MODEL_NAME=LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct
# PRIMARY_LLM_API_KEY=EMPTY

# Standard fallback vLLM runtime
FALLBACK_LLM_ENABLED=true
FALLBACK_LLM_BASE_URL=http://127.0.0.1:8000/v1
FALLBACK_LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct-AWQ
FALLBACK_LLM_API_KEY=EMPTY
HF_TOKEN=

# Runtime tuning
LLM_TIMEOUT_SECONDS=30
PRIMARY_LLM_TIMEOUT_SECONDS=30
FALLBACK_LLM_TIMEOUT_SECONDS=12
ROUTINE_PROFILE_TIMEOUT_SECONDS=30
LLM_HEALTH_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=0
LLM_MAX_TOKENS=500
ROUTINE_PROFILE_MAX_TOKENS=1800
LLM_TEMPERATURE=0.3
REQUEST_DEADLINE_SECONDS=90
ROUTINE_DAY_DETAIL_TIMEOUT_SECONDS=12

# Database
# Example PostgreSQL URL:
DATABASE_URL=postgresql+psycopg://pc2:pc2pass@127.0.0.1:5430/pc2_coach

# Notes
# - Empty or missing env values fall back to built-in defaults.
# - Standard runtime assumes fallback vLLM is running on port 8000 with Qwen/Qwen2.5-1.5B-Instruct-AWQ.
# - For Hugging Face managed EXAONE, start from `.env.hf-endpoint.example` and disable fallback.
# - If all LLM settings are unavailable, PC2 still runs and returns local rule-based plans for /api/coach/generate.
