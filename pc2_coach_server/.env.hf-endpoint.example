# Main service identity
SERVICE_NAME=pc2-coach-api

# Network binding
HOST=0.0.0.0
PORT=7000

# Primary LLM: Hugging Face Inference Endpoint
# Use the endpoint URL you created in Hugging Face Endpoints.
# This is NOT the public router URL.
PRIMARY_LLM_BASE_URL=https://<your-hf-endpoint-host>/v1
PRIMARY_LLM_MODEL_NAME=LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct
PRIMARY_LLM_API_KEY=<your-hf-endpoint-token>

# Fallback off for single-model operation
FALLBACK_LLM_ENABLED=false
FALLBACK_LLM_BASE_URL=http://127.0.0.1:8000/v1
FALLBACK_LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct-AWQ
FALLBACK_LLM_API_KEY=EMPTY

# Runtime tuning validated against EXAONE 2.4B endpoint-style usage
LLM_TIMEOUT_SECONDS=35
PRIMARY_LLM_TIMEOUT_SECONDS=35
ROUTINE_PROFILE_TIMEOUT_SECONDS=60
LLM_HEALTH_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=0
LLM_MAX_TOKENS=500
ROUTINE_PROFILE_MAX_TOKENS=900
LLM_TEMPERATURE=0.3
REQUEST_DEADLINE_SECONDS=120
ROUTINE_DAY_DETAIL_TIMEOUT_SECONDS=10

# Database
DATABASE_URL=postgresql+psycopg://pc2:pc2pass@127.0.0.1:5430/pc2_coach

# Notes
# - PRIMARY_LLM_API_KEY should be your Hugging Face endpoint token.
# - HF_TOKEN is not required for endpoint inference unless you also download models locally.
# - If you want to use local EXAONE instead, set PRIMARY_LLM_BASE_URL=http://127.0.0.1:8100/v1 and PRIMARY_LLM_API_KEY=EMPTY.
