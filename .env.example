# 기본 LLM
PRIMARY_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
PRIMARY_LLM_MODEL_NAME=google/gemma-4-31b-it
PRIMARY_LLM_API_KEY=

# 선택형 레거시 호환 변수
NVIDIA_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=
LLM_API_KEY=

# 선택형 보조 LLM
FALLBACK_LLM_ENABLED=false
FALLBACK_LLM_BASE_URL=http://127.0.0.1:8000/v1
FALLBACK_LLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
FALLBACK_LLM_API_KEY=EMPTY
VLLM_BASE_URL=
VLLM_MODEL_NAME=
VLLM_API_KEY=

# 실행 환경
DB_PATH=
SERVICE_NAME=pc2-coach-api
HOST=0.0.0.0
PORT=7000
LOG_LEVEL=info

# LLM 조정값
LLM_TIMEOUT_SECONDS=30
PRIMARY_LLM_TIMEOUT_SECONDS=45
FALLBACK_LLM_TIMEOUT_SECONDS=8
LLM_HEALTH_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.3
